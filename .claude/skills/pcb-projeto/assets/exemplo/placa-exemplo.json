  "folha": "A3",
  "tensao_max_v": 12,
  "blocos": [
    {
      "id": "entrada",
      "titulo": "Entrada 12 V e protecao",
      "componentes": ["J1", "F1", "Q1", "D1", "R1", "D2", "C1"],
      "notas": "F1 PTC SMD1812P200TF/16: 2 A de manutencao, 3,5 A de disparo, 16 V.\nQ1 AO3401A (P-MOSFET, Vds -30 V, Vgs max +-12 V) contra inversao: dreno na entrada, fonte na carga, gate ao GND por R1 10k.\nD1 zener 10 V (catodo na fonte) limita Vgs a -10 V; com 12 V na entrada, I(D1) = (12 - 10) / 10k = 0,2 mA.\nD2 SMAJ15A: VRWM 15 V > 12 V; Vc 24,4 V < 35 V (VIN max do AP63203) e < 45 V (VM maximo de operacao do DRV8871).\nC1 100 uF 25 V de volume na entrada protegida.\nPWR_FLAG em +12V e GND (chegam pelo borne) e em +12V_SYS (a fonte do Q1 e pino passivo; o ERC nao ve quem alimenta)."
    },
    {
      "id": "buck",
      "titulo": "Buck 12 V para 3,3 V (AP63203)",
      "componentes": ["U2", "C2", "C3", "C4", "L1", "C5", "C6"],
      "notas": "AP63203WU: saida fixa 3,3 V, 1,1 MHz, 2 A. Tabela 2 do datasheet: L 3,9 uH, entrada 10 uF, saida 2 x 22 uF, bootstrap 100 nF.\nL1 = 4,7 uH (FNR4018S4R7MT, Isat 2,2 A): 3,9 uH nao achado nessa serie na LCSC; 4,7 uH reduz o ripple. Conferir a Eq. 7 do datasheet.\nEN ligado direto em VIN (o datasheet permite: pino de alta tensao). FB direto na saida (versao fixa).\nPWR_FLAG em +3V3: a saida passa pela bobina (pino passivo), o ERC nao ve o regulador."
    },
    {
      "id": "mcu",
      "titulo": "ESP32-S3-WROOM-1",
      "componentes": ["U1", "R2", "C7", "R3", "SW1", "C8", "C9"],
      "notas": "EN: R2 10k ao 3V3 e C7 1 uF ao GND (tau = 10 ms).\nIO0: R3 10k de pull-up e SW1 (BOOT) ao GND.\nC8 10 uF + C9 100 nF junto ao pino 3V3 do modulo.\nIO4 e IO5 = MOTOR_IN1/IN2; IO6 = LED. Strapping (IO3, IO45, IO46) e USB (IO19/IO20) sem uso."
    },
    {
      "id": "motor",
      "titulo": "Driver de motor DC (DRV8871)",
      "componentes": ["U3", "R4", "C10", "C11", "R5", "R6", "J2"],
      "notas": "ITRIP = 64 / RILIM(kOhm) A (datasheet TI SLVSCY9B, Current Regulation; RILIM minimo 15k). R4 33k -> ITRIP = 1,94 A.\nC10 100 nF + C11 100 uF 25 V em VM, colados no CI.\nR5/R6 10k de pull-down em IN1/IN2: motor parado (coast) enquanto o ESP32 da boot.\nPino 7 (GND) e pad exposto (pino 9) no GND, com vias termicas."
    },
    {
      "id": "gravacao",
      "titulo": "Header UART0 de gravacao",
      "componentes": ["J3"],
      "notas": "1 GND, 2 3V3, 3 TX, 4 RX, 5 EN, 6 IO0.\nTX/RX do ponto de vista do ESP32: o RX do adaptador USB-serial vai no pino 3."
    },
    {
      "id": "led",
      "titulo": "LED de status",
      "componentes": ["R7", "D3"],
      "notas": "LED vermelho KT-0603R (Vf 2,0 a 2,4 V). R7 1k: I = (3,3 - 2,0) / 1k = 1,3 mA."
    }
  ],
